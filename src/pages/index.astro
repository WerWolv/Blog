---
import Layout from '~/layouts/Layout.astro'
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS } from '~/config.ts'
import { GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import { getNumPosts, getPinnedPosts } from '~/lib/data'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

let showPosts: any[] = []
const pinnedPosts = await getPinnedPosts()
const hasPinnedPosts = pinnedPosts.length > 0
if (hasPinnedPosts) {
  // Show pinned posts first, then fill the rest with non-pinned posts if needed
  const remainingSize = size - pinnedPosts.length
  if (remainingSize > 0) {
    const nonPinnedPosts = await getNumPosts(size * 2) // Get more posts to ensure we can fill the remaining slots after filtering out pinned ones
    const filteredNonPinnedPosts = nonPinnedPosts
      .filter((post) => !pinnedPosts.some((pinned) => pinned.data.title === post.data.title))
      .filter((post) => !post.data.hidden)
    showPosts = [...pinnedPosts, ...filteredNonPinnedPosts.slice(0, remainingSize)]
  } else {
    showPosts = pinnedPosts.slice(0, size) // If there are more pinned posts than the size limit, just show the top ones
  }
} else {
  showPosts = (await getNumPosts(size)).filter((post) => !post.data.hidden)
}
---

<Layout title="WerWolv's Blog" description={SITE.description}>
  <div class="relative z-[1]">
    <div class="py-8 pb-10 px-6 sm:px-8">
      <h1 class="flex flex-col gap-2">
        <span class="text-4xl sm:text-5xl tracking-tight"> WerWolv's Blog </span>
        <span class="text-muted-foreground font-light text-xl sm:text-2xl block tracking-wide text-balance"> </span>
      </h1>
      <div class="pro text-muted-foreground text-pretty"></div>
      <div class="mt-6 flex gap-6">
        {
          SOCIAL_LINKS.map((item) => {
            return (
              <SocialLink
                href={item.url}
                icon={item.icon}
                aria-label={`Link of ${item.name}`}
                count={item.count}
                hoverColor={item.hoverColor}
                label="followers"
              />
            )
          })
        }
      </div>
    </div>
    <SectionDivider />
    <div class="py-8 pb-10 px-6 sm:px-8">
      <a href="./posts">
        <h2 class="text-2xl sm:text-3xl tracking-tight">Posts</h2>
      </a>
      <p class="text-muted-foreground mb-6 mt-1">Most relevant posts, worth a look.</p>
      <List posts={showPosts} {type} coverLayout={POSTS_CONFIG.homePageConfig?.coverLayout} />
      <a
        href={`/posts`}
        class="hidden sm:inline-flex mt-2 items-center gap-2 text-sm font-medium text-foreground/60 hover:text-primary transition-colors group/read float-right"
      >
        More Blog Posts
        <span class="icon-[ph--arrow-right] size-4 transition-transform group-hover/read:translate-x-1"></span>
      </a>
    </div>
    {
      ENABLED && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl">Code Contributions</h2>
              <p class="text-muted-foreground mb-6 mt-1">Open Source work in the past year</p>
            </div>
            <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:load transition:animate="none" />
          </div>
        </>
      )
    }
    {
      SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl tracking-tight">Skills</h2>
              <p class="text-muted-foreground mb-6 mt-1">Things I know</p>
            </div>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </>
      )
    }
  </div>
</Layout>
