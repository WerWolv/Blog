---
import Layout from '~/layouts/Layout.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import Prose from '~/components/posts/base/Prose.astro'
import { Content, frontmatter } from '~/content/about.mdx'
---

<Layout title={frontmatter.title} description={frontmatter.subtitle || ''}>
  <div class="relative z-1 py-8 pb-10 px-6 sm:px-8">
    <PageTitle title={frontmatter.title} introduce={frontmatter.subtitle || ''} />
    <div class="mt-8">
      <Prose>
        <Content />
      </Prose>
    </div>
  </div>
</Layout>
