---
import { Image } from 'astro:assets'
import { cn } from '~/lib/utils'

interface Props {
  src: ImageMetadata
  alt: string
  class?: string
}

const { src, alt, class: className } = Astro.props
---

<figure>
  <Image {src} {alt} class={cn('rounded-sm shadow-lg my-6 flex flex-col items-center', className)} />
  <figcaption class="-m-3">{alt}</figcaption>
</figure>
