---
interface Props {
  icon?: string
  colorClass?: string
  lineColorClass?: string
}

const {
  icon = 'lucide--sparkles',
  colorClass = 'text-indigo-300 dark:text-indigo-700',
  lineColorClass = 'text-neutral-200 dark:text-neutral-800',
} = Astro.props as Props
---

<div class:list={['my-12 flex items-center justify-center gap-4', lineColorClass]}>
  <div class="h-px bg-linear-to-r from-transparent to-current flex-1"></div>
  <span class:list={[`icon-[${icon}]`, 'block size-4', colorClass]} aria-hidden="true"></span>
  <div class="h-px bg-linear-to-l from-transparent to-current flex-1"></div>
</div>
